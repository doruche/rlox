var a = "global";
{
    fun show() {
        print a;
    }

    show();
    var a = "block";
    show();
}
var x = 10;
var add_x = |y| y + x;
print add_x(5);

fun make_closure() {
    var x = 10;
    return |y| y + x;
}
var closure = make_closure();
print closure(5);

var add_x = || x = x + 1;
add_x();
add_x();
print x;

x = 10;

var outer_closure = |y| {
    var z = x + y;
    return |w| z + w;
};
var inner_closure = outer_closure(5);
print inner_closure(3);

var y = 20;
var add_xy = |z| x + y + z;
print add_xy(5);

var incre_x = || x = x + 1;
var decre_x = || x = x - 1;
print incre_x();
print decre_x();
print incre_x();

var get_x = || x;
x = 20;
print get_x();