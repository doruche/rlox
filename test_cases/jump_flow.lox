for (var i = 0; i < 5; i = i + 1) {
    print i;
    if i == 3 {
        break;
    }
}

for (var i = 0; i < 10; i = i + 1) {
    if i == 2 {
        continue; // 跳过 2
    }
    if i == 7 {
        break; // 当 i 等于 7 时退出循环
    }
    print i; // 预期输出: 0 1 3 4 5 6
}

fun print_pair(m, n) {
    for (var i = 0; i < m; i = i + 1) {
        if i == 1 {
            return print_pair;
        }
        for (var j = 0; j < n; j = j + 1) {
            if i == j {
                continue;
            }
            print "(" + i + ", " + j + ")";
        }
    }
}

print print_pair(3,3);

fun nested_loops() {
    for (var i = 0; i < 3; i = i + 1) {
        if i == 1 {
            continue; // 当 i 等于 1 时跳过本次外层循环
        }
        for (var j = 0; j < 3; j = j + 1) {
            if j == 2 {
                break; // 当 j 等于 2 时退出内层循环
            }
            for (var k = 0; k < 3; k = k + 1) {
                if k == 1 {
                    continue; // 当 k 等于 1 时跳过本次最内层循环
                }
                print "(" + i + ", " + j + ", " + k + ")";
            }
        }
    }
    // 预期输出: (0, 0, 0) (0, 0, 2) (0, 1, 0) (0, 1, 2) (2, 0, 0) (2, 0, 2) (2, 1, 0) (2, 1, 2)
}

nested_loops();

var f1 = 1;
var f2 = 1;
fun fib_iter(n) {
    while n > 0 {
        var t = f2;
        f2 = f1 + f2;
        f1 = t;
        n = n - 1;
    }
}
